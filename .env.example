# ─────────────────────────────────────────────────────────────────────────────
# SOAR Hub environment configuration. Copy to .env (local) or set in your host.
# NEVER commit real secrets. Values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# Core ------------------------------------------------------------------------
NODE_ENV=development
# PostgreSQL (Supabase: use the *transaction pooler* URI, port 6543, for serverless)
DATABASE_URL=postgresql://soar:soar@localhost:5432/soar_hub
DATABASE_POOL_MAX=10
# Public base URL used in emails and links (https in production)
APP_URL=http://localhost:3000
# ≥32 random chars. Signs/HMACs session, verification, reset and referee tokens.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Shared secret for /api/cron/* (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me-cron-secret

# File storage ----------------------------------------------------------------
# "s3" in production (Supabase Storage S3 endpoint, AWS S3, Cloudflare R2).
# "local" is development-only and is refused when NODE_ENV=production.
STORAGE_DRIVER=local
STORAGE_BUCKET=soar-documents
# Supabase example: https://<project-ref>.supabase.co/storage/v1/s3   (leave empty for AWS)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=.dev-storage

# Email -----------------------------------------------------------------------
# resend | sendgrid | console (dev only: logs + writes .dev-storage/outbox.jsonl) | none
# Email: "console" keeps emails local (see /dev/mailbox). For real delivery see docs/EMAIL_SETUP.md (Gmail or Resend).
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
# Gmail (no domain needed): EMAIL_PROVIDER=smtp + a Google App Password. See docs/EMAIL_SETUP.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SOAR Hub <no-reply@your-domain.ng>"
# Resend: the webhook signing secret (whsec_...). SendGrid: a random string appended as ?secret=
EMAIL_WEBHOOK_SECRET=

# SMS (optional) ---------------------------------------------------------------
# africastalking | console (dev) | none
SMS_PROVIDER=none
SMS_PROVIDER_API_KEY=
# Africa's Talking username ("sandbox" uses the sandbox API)
SMS_PROVIDER_USERNAME=
SMS_SENDER_ID=
SMS_WEBHOOK_SECRET=

# AI essay critique (optional; always human-approved) ---------------------------
# anthropic | openai | none
AI_PROVIDER=none
AI_API_KEY=
# Defaults: claude-opus-5-5 (anthropic) / gpt-4.1 (openai)
AI_MODEL=

# Semantic answer-bank search (optional; keyword fallback otherwise) ---------------
# openai | voyage | none
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_API_KEY=
# Defaults: text-embedding-3-small (openai) / voyage-3.5 (voyage)
EMBEDDINGS_MODEL=

# Malware scanning (optional; uploads are marked "not scanned" without it) --------
CLAMAV_HOST=
CLAMAV_PORT=3310

# Monitoring (optional) ------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# Local tooling only ---------------------------------------------------------------
# DISABLE_RATE_LIMIT=true   # ignored in production
# TEST_DATABASE_URL=postgresql://soar:soar@localhost:5432/soar_hub_test
# DEMO_PASSWORD=...         # password for SEED_DEMO accounts
