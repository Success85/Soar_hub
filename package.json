{
  "name": "soar-hub",
  "version": "1.0.0",
  "private": true,
  "description": "SOAR Hub — scholarship application support platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --require ./scripts/stub-server-only.cjs scripts/seed.ts",
    "db:create-admin": "tsx --require ./scripts/stub-server-only.cjs scripts/create-admin.ts",
    "worker": "tsx --require ./scripts/stub-server-only.cjs scripts/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --trace off",
    "db:seed:demo": "SEED_DEMO=true tsx --require ./scripts/stub-server-only.cjs scripts/seed.ts",
    "db:import-scholarships": "tsx --require ./scripts/stub-server-only.cjs scripts/import-scholarships.ts",
    "db:import-resources": "tsx --require ./scripts/stub-server-only.cjs scripts/import-resources.ts",
    "demo:setup": "npm run db:migrate && npm run db:seed && npm run db:import-scholarships && npm run db:import-resources && npm run db:seed:demo",
    "logos:fetch": "tsx --require ./scripts/stub-server-only.cjs scripts/fetch-logos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@hookform/resolvers": "^7.0.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "postgres": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
